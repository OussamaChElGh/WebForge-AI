{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx"
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "motion/**/*.mjs",
    "components/**/*.tsx",
    "components/**/*.ts",
    "qa/fixture/**/*.tsx",
    "playwright.visual.config.ts"
  ]
}
