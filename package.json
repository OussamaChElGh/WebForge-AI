{
  "name": "webforge-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "spec:check": "node scripts/check-spec.mjs",
    "build": "tsc -p tsconfig.build.json",
    "qa:serve": "node qa/serve-fixture.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "motion": "14.7.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2"
  },
  "description": "Creative Frontend Enhancement Framework",
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "gsap": "^3.15.0",
    "motion": "^14.7.1"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  },
  "exports": {
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/TextReveal": {
      "types": "./dist/components/TextReveal.d.ts",
      "import": "./dist/components/TextReveal.js"
    },
    "./components/ParallaxHero": {
      "types": "./dist/components/ParallaxHero.d.ts",
      "import": "./dist/components/ParallaxHero.js"
    },
    "./components/MagneticButton": {
      "types": "./dist/components/MagneticButton.d.ts",
      "import": "./dist/components/MagneticButton.js"
    }
  },
  "files": [
    "dist/components",
    "dist/motion",
    "styles",
    "components/README.md",
    "docs/dependencies.md"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
